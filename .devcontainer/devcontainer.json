{
  // Name of the dev container configuration
  "name": "Python 3 Development Environment",

  // Base container image - using official Microsoft Python dev container
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",

  // Customization settings for the development environment
  "customizations": {
    // GitHub Codespaces specific settings
    "codespaces": {
      "openFiles": [
        "README.md",
        "bot.py"
      ]
    },
    // VS Code specific settings and extensions
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": true,
        "python.formatting.provider": "black",
        "editor.formatOnSave": true,
        "editor.rulers": [88],
        "files.trimTrailingWhitespace": true
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "visualstudioexptteam.vscodeintellicode"
      ]
    }
  },

  // Command to run on container creation to install dependencies
  "updateContentCommand": [
    "sh",
    "-c",
    "set -e && \
     if [ -f packages.txt ]; then \
       sudo apt-get update && \
       sudo apt-get upgrade -y && \
       sudo xargs apt-get install -y < packages.txt; \
     fi && \
     if [ -f requirements.txt ]; then \
       pip3 install --user -r requirements.txt; \
     fi && \
     pip3 install --user streamlit && \
     echo '✅ Packages installed and Requirements met'"
  ],

  // Command to run after container is attached
  "postAttachCommand": {
    "server": "streamlit run bot.py --server.enableCORS false --server.enableXsrfProtection false"
  },

  // Port configuration
  "portsAttributes": {
    "8501": {
      "label": "Streamlit Application",
      "onAutoForward": "openPreview",
      "protocol": "http"
    }
  },

  // Ports to forward to local machine
  "forwardPorts": [
    8501
  ],

  // Additional container features
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Security-related settings
  "securityOpt": [
    "no-new-privileges:true"
  ],

  // Resource limits
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "32gb"
  }
}