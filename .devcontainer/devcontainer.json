{
  "name": "Python 3 Development Environment",
  // Container configuration
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  
  // Development environment customizations
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "bot.py"
      ]
    },
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": true,
        "python.formatting.provider": "black",
        "editor.formatOnSave": true,
        "editor.rulers": [88],
        "files.trimTrailingWhitespace": true
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "njpwerner.autodocstring",
        "streetsidesoftware.code-spell-checker",
        "eamodio.gitlens",
        "GitHub.copilot"
      ]
    }
  },

  // Environment setup and package installation
  "updateContentCommand": [
    "if [ -f packages.txt ]; then",
    "  sudo apt update && sudo apt upgrade -y",
    "  sudo xargs apt install -y < packages.txt",
    "fi",
    "if [ -f requirements.txt ]; then",
    "  pip3 install --user -r requirements.txt",
    "fi",
    "pip3 install --user streamlit black pylint pytest",
    "echo '✅ Development environment setup complete'"
  ].join(" && "),

  // Application startup configuration
  "postAttachCommand": {
    "server": "streamlit run bot.py --server.enableCORS false --server.enableXsrfProtection false --server.address 0.0.0.0"
  },

  // Port configuration
  "portsAttributes": {
    "8501": {
      "label": "Streamlit Application",
      "onAutoForward": "openPreview",
      "protocol": "http"
    }
  },
  "forwardPorts": [8501],

  // Security settings
  "remoteUser": "vscode",
  "features": {
    "git": "latest",
    "github-cli": "latest"
  },

  // Additional container settings
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt",
    "seccomp=unconfined"
  ],

  // Mount local SSH keys for git operations
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
  ]
}