{
  "name": "Python 3 Development Environment",
  "description": "Development container configuration for Python-based Streamlit application",
  
  // Base container image configuration
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  
  // VS Code and GitHub Codespaces specific customizations
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "bot.py"
      ]
    },
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": true,
        "python.formatting.provider": "black",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": true
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "ms-python.isort",
        "njpwerner.autodocstring",
        "streetsidesoftware.code-spell-checker"
      ]
    }
  },

  // Environment setup and package installation
  "updateContentCommand": [
    "set -e",
    "if [ -f packages.txt ]; then",
    "    sudo apt update && sudo apt upgrade -y",
    "    sudo xargs apt install -y < packages.txt",
    "fi",
    "if [ -f requirements.txt ]; then",
    "    pip3 install --user -r requirements.txt",
    "fi",
    "pip3 install --user streamlit pylint black isort",
    "echo '✅ Packages installed and Requirements met'"
  ].join(" && "),

  // Application startup configuration
  "postAttachCommand": {
    "server": "streamlit run bot.py --server.enableCORS false --server.enableXsrfProtection false --server.address 0.0.0.0"
  },

  // Port configuration
  "portsAttributes": {
    "8501": {
      "label": "Streamlit Application",
      "onAutoForward": "openPreview",
      "protocol": "http"
    }
  },
  "forwardPorts": [8501],

  // Container features and security
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Health check configuration
  "overrideCommand": true,
  "initializeCommand": {
    "ensurePermissions": "if [ -d .devcontainer ]; then chmod -R 0777 .devcontainer; fi"
  },

  // Development environment variables
  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}",
    "PYTHONUNBUFFERED": "1",
    "STREAMLIT_ENV": "development"
  },

  // Shutdown action
  "shutdownAction": "stopContainer"
}